[Unit]
Description=A-NAS Host Agent
After=local-fs.target

[Service]
Type=simple
ExecStart=%h/apps/a-nas/current/anas-host-agent
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s
RuntimeDirectory=a-nas
RuntimeDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=default.target
