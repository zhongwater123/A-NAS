[Unit]
Description=A-NAS local desktop on %I
Documentation=https://github.com/zhongwater123/A-NAS
After=systemd-user-sessions.service plymouth-quit-wait.service
Before=graphical.target
ConditionPathExists=/dev/tty0
ConditionPathExists=/opt/a-nas/current/kiosk-launcher
Wants=dbus.socket systemd-logind.service
After=dbus.socket systemd-logind.service
Conflicts=getty@%i.service
After=getty@%i.service

[Service]
Type=simple
# An account of its own (deploy/sysusers.d/a-nas-kiosk.conf, issue #174), not
# the staging account: it cannot log in, and cannot write staged releases. The
# launcher comes from the installed release. The state directory holds the
# Chromium profile and serves as HOME, as the account has none.
User=a-nas-kiosk
StateDirectory=a-nas-kiosk
StateDirectoryMode=0700
Environment=HOME=%S/a-nas-kiosk
EnvironmentFile=-/etc/a-nas/kiosk.env
ExecStart=/usr/bin/cage -s -- /opt/a-nas/current/kiosk-launcher
ExecStartPost=+/bin/sh -c "tty_name='%i'; exec /usr/bin/chvt $${tty_name#tty}"
Restart=always
RestartSec=3s
TimeoutStopSec=10s
UtmpIdentifier=%I
UtmpMode=user
TTYPath=/dev/%I
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
PAMName=a-nas-kiosk

[Install]
WantedBy=graphical.target
DefaultInstance=tty1
