[Unit]
Description=A-NAS voice Worker socket
Documentation=https://github.com/zhongwater123/A-NAS

[Socket]
# The first connection starts anas-voice.service, which serves connections one
# at a time and exits when idle (docs/architecture/voice.md). Only the Product
# Service's group reaches it.
ListenStream=/run/a-nas-voice/voice.sock
SocketUser=root
SocketGroup=a-nas
SocketMode=0660
DirectoryMode=0755

[Install]
WantedBy=sockets.target
