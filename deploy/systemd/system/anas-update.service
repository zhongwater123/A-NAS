[Unit]
Description=A-NAS system update
Documentation=https://github.com/zhongwater123/A-NAS/blob/main/docs/specs/system-update.md
# Installing a release restarts the Host Agent and the Product Service, so the
# update runs in a unit of its own (docs/specs/system-update.md#边界与失败).
# The path unit starts it when the Host Agent leaves a request; the timer
# starts it for periodic checks. An interrupted install is finished first.
After=network-online.target local-fs.target
# On a device that runs the A-NAS image, the same service switches the
# product's system extension and has systemd-sysupdate write a new base
# (internal/systemupdate/updater/image.go).
# Each request starts a run, as often as administrators ask; systemd's
# default limit of five starts in ten seconds would drop a request, which
# the Host Agent has already answered as taken.
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/lib/a-nas/anas-host-agent update
# ANAS_UPDATE_STAGING: the directory a development machine pushes the signed
# repository, or an image device's update files, into
# (docs/decisions/2026-11-13-release-by-lan-push.md); ANAS_UPDATE_URL: the
# address an image device downloads them from instead.
EnvironmentFile=-/etc/a-nas/site.conf
StateDirectory=a-nas-update
StateDirectoryMode=0700
# apt and dpkg write /usr, /etc and /var, and on an image device
# systemd-sysupdate writes the system disk's partitions and the ESP, so the
# unit is not confined; it runs no program from what was pushed or
# downloaded, only apt, dpkg, systemd's tools, the merged product's
# maintainer scripts and a-nas-check.
Environment=LC_ALL=C DEBIAN_FRONTEND=noninteractive
Nice=10
IOSchedulingClass=idle
# An install of new models copies gigabytes.
TimeoutStartSec=2h
