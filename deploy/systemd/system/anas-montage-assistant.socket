[Unit]
Description=A-NAS montage center socket for members' scheduled tasks
# The montage center's socket for planning by members' VNAS
# (docs/architecture/montage-center.md, MCP 服务器): the round script and the
# montage MCP server of a member's cron unit reach it, and the service learns
# the member from the peer UID. Open to every UID, so its directory is root's
# alone; only anas-assistant-cron@.service binds it into its sandbox, never a
# conversation's instance or the curator. systemd holds it, so it outlives
# restarts of the montage service. anas-montage.service takes it (Sockets=).

[Socket]
ListenStream=/run/a-nas-montage-assistant/assistant.sock
SocketMode=0666
DirectoryMode=0700
FileDescriptorName=assistant
Service=anas-montage.service

[Install]
WantedBy=sockets.target
