[Unit]
Description=A-NAS montage center socket for planning by members' VNAS
# The montage center's socket for planning by members' VNAS
# (docs/architecture/montage-planning-session.md): the montage MCP server of a
# member's planning instance reaches it, and the service learns the member
# from the peer UID; root's planner claims and reports rounds on it, naming
# the member. Open to every UID, so its directory is root's alone; only
# anas-assistant-plan@.service binds it into its sandbox, never a
# conversation's instance, the scheduled tasks or the curator. systemd holds
# it, so it outlives restarts of the montage service. anas-montage.service
# takes it (Sockets=).

[Socket]
ListenStream=/run/a-nas-montage-assistant/assistant.sock
SocketMode=0666
DirectoryMode=0700
FileDescriptorName=assistant
Service=anas-montage.service

[Install]
WantedBy=sockets.target
