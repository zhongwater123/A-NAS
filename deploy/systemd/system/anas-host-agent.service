[Unit]
Description=A-NAS privileged Host Agent
Documentation=https://github.com/zhongwater123/A-NAS
After=local-fs.target smbd.service
Wants=smbd.service

[Service]
Type=simple
# Runs as root without User=/Group=. With an explicit User= and a seccomp
# filter (RestrictAddressFamilies), systemd 257 drops CAP_SETUID, and the File
# Broker could no longer start workers as the signed-in user (issue #38).
Environment=ANAS_HOST_AGENT_SOCKET=/run/a-nas/host-agent.sock
Environment=ANAS_FILE_BROKER_SOCKET=/run/a-nas/file-broker.sock
Environment=ANAS_STATE_DIR=/var/lib/a-nas
Environment=ANAS_HOST_AGENT_GROUP=a-nas
Environment=ANAS_PHOTO_SESSION_SOCKET=/run/a-nas-sessions/photos.sock
Environment=ANAS_PHOTO_SESSION_GROUP=a-nas-photos
Environment=ANAS_SHARE_SESSION_SOCKET=/run/a-nas-share-sessions/shares.sock
Environment=ANAS_SHARE_SESSION_GROUP=a-nas-shares
Environment=ANAS_FAMILY_SESSION_SOCKET=/run/a-nas-family-sessions/family.sock
Environment=ANAS_FAMILY_SESSION_GROUP=a-nas-family
Environment=ANAS_DATA_MOUNT=/srv/a-nas/data
# This machine's settings, such as ANAS_SMB_INTERFACE (ADR 0034).
EnvironmentFile=-/etc/a-nas/site.conf
ExecStart=/usr/lib/a-nas/anas-host-agent
Restart=on-failure
RestartSec=2s
# The Host Agent serves at once and reconciles the data volume afterwards, so
# a volume it cannot reconcile no longer stops it (issue #166).
TimeoutStopSec=20s
# Separate session directories preserve the photo, share and family socket
# group permissions.
RuntimeDirectory=a-nas a-nas-sessions a-nas-share-sessions a-nas-family-sessions a-nas-module-sessions
RuntimeDirectoryMode=0750
# The Host Agent's records (spaces, identities, viewing grants, app
# identities, data-volume operations) live where only root can open them.
# Releases before issue #176 kept them in /var/lib/a-nas, the Product
# Service's StateDirectory; the Host Agent moves them from there at start.
StateDirectory=a-nas-host
StateDirectoryMode=0700
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# shadow-utils creates transient lock and backup files beside passwd/group.
# The Host Agent is already the typed root trust boundary and writes systemd units.
# /sys/devices: after adding a disk to the data volume, the Host Agent asks
# udev to probe it again by writing its uevent file (ProtectKernelTunables).
# /var/lib/a-nas: the Product Service's session database, which the File
# Broker reads, and the records of older releases it moves out.
ReadWritePaths=/etc /var/lib/a-nas /var/lib/samba /srv/a-nas /run/a-nas /run/samba /sys/devices
RestrictAddressFamilies=AF_UNIX
# What the Host Agent and its commands use (issue #166): users' identities for
# file workers and terminals (SETUID, SETGID); owners and ACLs on everyone's
# files (CHOWN, DAC_*, FOWNER, FSETID); disks, mounts and Btrfs (SYS_ADMIN,
# SYS_RAWIO for SMART); stopping workers and shells (KILL); the task manager's
# I/O and icon reads of other users' processes (SYS_PTRACE); and the system
# disk's root reserve for its own records (SYS_RESOURCE).
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_FSETID CAP_KILL CAP_SETGID CAP_SETUID CAP_SYS_ADMIN CAP_SYS_PTRACE CAP_SYS_RAWIO CAP_SYS_RESOURCE
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
# Without DeviceAllow= this leaves every device reachable: it only implies
# DeviceAllow=char-rtc where a device policy is already set (systemd 257).
ProtectClock=true
LockPersonality=true
# Also holds for the administrators' shells, which start from here.
RestrictNamespaces=true
SystemCallArchitectures=native
# File workers and terminal shells run in scopes of their own and are not
# counted here (issue #166).
MemoryMax=1G
TasksMax=512

[Install]
WantedBy=multi-user.target
