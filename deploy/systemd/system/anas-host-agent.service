[Unit]
Description=A-NAS privileged Host Agent
Documentation=https://github.com/zhongwater123/A-NAS
After=local-fs.target smbd.service
Wants=smbd.service

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/a-nas/host-agent.env
ExecStart=/opt/a-nas/current/anas-host-agent
Restart=on-failure
RestartSec=2s
TimeoutStartSec=30min
TimeoutStopSec=20s
RuntimeDirectory=a-nas
RuntimeDirectoryMode=0750
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/samba /etc/systemd/system /etc/passwd /etc/shadow /etc/group /etc/gshadow -/etc/subuid -/etc/subgid /var/lib/a-nas /var/lib/samba /srv/a-nas /run/a-nas /run/samba
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
