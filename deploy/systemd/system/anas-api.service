[Unit]
Description=A-NAS local Product Service
Documentation=https://github.com/zhongwater123/A-NAS
After=anas-host-agent.service anas-site.service
Wants=anas-host-agent.service anas-site.service

[Service]
Type=simple
User=a-nas
Group=a-nas
# Reaches the photo service's API socket; the photo store itself stays
# private to a-nas-photos (ADR 0011). Web search's socket likewise (ADR 0030).
SupplementaryGroups=a-nas-photos a-nas-shares a-nas-family a-nas-search
Environment=ANAS_HTTP_ADDR=127.0.0.1:8080
Environment=ANAS_HOSTSTATE_MODE=agent
Environment=ANAS_HOST_AGENT_SOCKET=/run/a-nas/host-agent.sock
Environment=ANAS_FILE_BROKER_SOCKET=/run/a-nas/file-broker.sock
Environment=ANAS_PHOTOS_SOCKET=/run/a-nas-photos/photos.sock
Environment=ANAS_FFMPEG_SOCKET=/run/a-nas-ffmpeg/ffmpeg.sock
Environment=ANAS_FFMPEG_SLOTS=/run/a-nas-ffmpeg/slots
Environment=ANAS_STATE_DIR=/var/lib/a-nas
# Screen saver videos are long-lived media outside the release (ADR 0014).
Environment=ANAS_SCREENSAVER_DIRECTORY=/var/lib/a-nas/screensavers/current
Environment=ANAS_DATA_MOUNT=/srv/a-nas/data
Environment=ANAS_WEB_SEARCH_SOCKET=/run/a-nas-search/search.sock
Environment=ANAS_WEB_SEARCH_RELEASE=/usr/lib/a-nas/search
# SearXNG's secret, which anas-site.service makes once (ADR 0030).
Environment=ANAS_WEB_SEARCH_SECRET_FILE=/etc/a-nas/search.env
# This machine's settings: the terminal and the App Center are off until the
# administrator turns them on there (ADR 0034). a-nas-generator adds the
# internet entry's listener when /etc/a-nas/internet.env turns it on.
EnvironmentFile=-/etc/a-nas/site.conf
ExecStart=/usr/lib/a-nas/anas-api
Restart=on-failure
RestartSec=2s
TimeoutStopSec=20s
StateDirectory=a-nas
StateDirectoryMode=0700
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# File contents are read and written through the File Broker as the user.
ReadWritePaths=/var/lib/a-nas /run/a-nas-share-files
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Ceilings far above what the Product Service uses (tens of threads and of
# descriptors), so that a runaway, or callers on its sockets getting past
# the bounds of their own, stop here instead of taking the device's
# processes or kernel memory. Go raises the soft descriptor limit to the
# hard one, systemd's 524288 without this. Threads past TasksMax end the
# process, and Restart= brings it back. No MemoryMax: what the service
# needs grows with members, windows and transfers, and no measurement on a
# device says where a cap would not cut normal use.
TasksMax=4096
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
