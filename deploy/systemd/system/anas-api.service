[Unit]
Description=A-NAS local Product Service
Documentation=https://github.com/zhongwater123/A-NAS
After=anas-host-agent.service
Wants=anas-host-agent.service

[Service]
Type=simple
User=a-nas
Group=a-nas
# Reaches the photo service's API socket; the photo store itself stays
# private to a-nas-photos (ADR 0011). Web search's socket likewise (ADR 0030).
SupplementaryGroups=a-nas-photos a-nas-shares a-nas-family a-nas-search
EnvironmentFile=/etc/a-nas/anas-api.env
ExecStart=/opt/a-nas/current/anas-api
Restart=on-failure
RestartSec=2s
TimeoutStopSec=20s
StateDirectory=a-nas
StateDirectoryMode=0700
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# File contents are read and written through the File Broker as the user.
ReadWritePaths=/var/lib/a-nas /run/a-nas-share-files
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
