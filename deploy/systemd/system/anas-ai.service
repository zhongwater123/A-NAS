[Unit]
Description=A-NAS local AI Worker
Documentation=https://github.com/zhongwater123/A-NAS
Requires=anas-ai.socket
After=anas-ai.socket

[Service]
Type=simple
# Turns thumbnails the photo service passes as descriptors, and search text,
# into vectors, finds the things and faces in photos, and reads their text
# through a llama-server child on a UNIX socket. It has no network and no data
# volume, so photos cannot leave the device through it (ADR 0011, ADR 0016);
# the system test proves both.
User=a-nas-ai
DynamicUser=true
# The installer links the release's runtime, models and llama.cpp to the
# copies it keeps once per content under /opt/a-nas.
Environment=PYTHONPATH=/opt/a-nas/current/ai
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/a-nas/current/ai/runtime/bin/python -m anas_ai.worker --model /opt/a-nas/current/ai/model.litertlm --manifest /opt/a-nas/current/ai/model.json --cache-dir /var/cache/a-nas-ai --detector /opt/a-nas/current/ai/detector.onnx --detector-manifest /opt/a-nas/current/ai/detector.json --face-detector /opt/a-nas/current/ai/face-detector.onnx --face-detector-manifest /opt/a-nas/current/ai/face-detector.json --face-embedder /opt/a-nas/current/ai/face-embedder.onnx --face-embedder-manifest /opt/a-nas/current/ai/face-embedder.json --animal-embedder /opt/a-nas/current/ai/animal-embedder.onnx --animal-embedder-manifest /opt/a-nas/current/ai/animal-embedder.json --ocr-server /opt/a-nas/current/ai/llama/llama-server --ocr-runtime-manifest /opt/a-nas/current/ai/llama.json --ocr-model /opt/a-nas/current/ai/ocr-model.gguf --ocr-model-manifest /opt/a-nas/current/ai/ocr-model.json --ocr-mmproj /opt/a-nas/current/ai/ocr-mmproj.gguf --ocr-mmproj-manifest /opt/a-nas/current/ai/ocr-mmproj.json
# XNNPack keeps repacked weights here so later starts load faster.
CacheDirectory=a-nas-ai
CacheDirectoryMode=0700
UMask=0077
TimeoutStopSec=20s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
RestrictAddressFamilies=AF_UNIX
ProtectHome=true
ProtectSystem=strict
InaccessiblePaths=-/srv/a-nas
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
# Memory has no fixed budget (user, 2026-10-28): background work loads a
# model only if 1 GiB stays free afterwards, and the Worker releases its
# models when free memory falls below that (internal/photoservice/gate.go,
# docs/architecture/photo-objects.md#资源策略). The installer's
# anas-ai.service.d/memory-reserve.conf caps the Worker at all of this
# machine's memory but 2.5 GiB, only against a runaway. The models are never
# swapped out, which would make inference crawl and keep the disk busy, and
# when memory runs out the kernel ends the Worker before anything else.
MemorySwapMax=0
OOMScoreAdjust=500
# AI works while the photo library is idle with every core but two, which stay
# free for what the user does next: the Worker runs that many threads, and the
# installer caps it at that many cores in anas-ai.service.d/cpu-reserve.conf.
# A slice of its own under anas.slice, beside system.slice and user.slice:
# anas.slice gives way to those, the device's other work, whenever they want
# a core, and the photo service stops AI work when their pressure rises; the
# Worker's threads waiting on each other must not count
# (internal/photoservice/gate.go).
Slice=anas-ai.slice
