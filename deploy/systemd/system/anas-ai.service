[Unit]
Description=A-NAS local AI Worker
Documentation=https://github.com/zhongwater123/A-NAS
Requires=anas-ai.socket
After=anas-ai.socket

[Service]
Type=simple
# Turns thumbnails the photo service passes as descriptors, and search text,
# into vectors, and finds the things and faces in photos. It has no network and no data
# volume, so photos cannot leave the device through it (ADR 0011, ADR 0016);
# the system test proves both.
User=a-nas-ai
DynamicUser=true
# The installer links the release's runtime and models to the copies it keeps
# once per content under /opt/a-nas.
Environment=PYTHONPATH=/opt/a-nas/current/ai
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/a-nas/current/ai/runtime/bin/python -m anas_ai.worker --model /opt/a-nas/current/ai/model.litertlm --manifest /opt/a-nas/current/ai/model.json --cache-dir /var/cache/a-nas-ai --detector /opt/a-nas/current/ai/detector.onnx --detector-manifest /opt/a-nas/current/ai/detector.json --face-detector /opt/a-nas/current/ai/face-detector.onnx --face-detector-manifest /opt/a-nas/current/ai/face-detector.json --face-embedder /opt/a-nas/current/ai/face-embedder.onnx --face-embedder-manifest /opt/a-nas/current/ai/face-embedder.json
# XNNPack keeps repacked weights here so later starts load faster.
CacheDirectory=a-nas-ai
CacheDirectoryMode=0700
UMask=0077
TimeoutStopSec=20s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
RestrictAddressFamilies=AF_UNIX
ProtectHome=true
ProtectSystem=strict
InaccessiblePaths=-/srv/a-nas
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
# The embedding model peaked at 815 MB on the Experimental NAS, the detector
# adds about 400 MiB while it is loaded (docs/architecture/photo-objects.md),
# and the face models load and unload with it
# (docs/architecture/photo-people.md).
# Above MemoryHigh the kernel reclaims first; MemoryMax is the hard limit.
MemoryHigh=1792M
MemoryMax=2G
# AI works while the photo library is idle with every core but two, which stay
# free for what the user does next: the Worker runs that many threads, and the
# installer caps it at that many cores in anas-ai.service.d/cpu-reserve.conf.
# A slice of its own under anas.slice, beside system.slice and user.slice:
# anas.slice gives way to those, the device's other work, whenever they want
# a core, and the photo service stops AI work when their pressure rises; the
# Worker's threads waiting on each other must not count
# (internal/photoservice/gate.go).
Slice=anas-ai.slice
