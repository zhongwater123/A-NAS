# The boot health check of an image version (/usr/lib/a-nas-image/health).
# Only a boot that systemd-boot counts is assessed, a new version's first
# boots: a check that fails here and passed on the version before reboots, so
# the next try, or the version before, starts without anyone at the device. A
# setting or a disk that already failed before does not hold a version back
# (a-nas-health-baseline.service). A blessed boot is not assessed, so a check
# that fails later never reboots a device in a loop; the update service
# reports it.
[Unit]
Description=A-NAS boot health check
ConditionPathExists=/sys/firmware/efi/efivars/LoaderBootCountPath-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f
After=multi-user.target
Before=boot-complete.target
FailureAction=reboot

[Service]
Type=oneshot
RemainAfterExit=yes
StateDirectory=a-nas-health
ExecStart=/usr/lib/a-nas-image/health assess
