# Gives a device what this image adds to /etc (/usr/lib/a-nas-image/etc-defaults),
# before the accounts are made and before a-nas-sysext-ready.service reloads
# the units, so that a unit link a new package put in /etc counts at this boot.
[Unit]
Description=Add what this image's packages put in /etc
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target systemd-sysusers.service systemd-tmpfiles-setup.service a-nas-sysext-ready.service shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/a-nas-image/etc-defaults
