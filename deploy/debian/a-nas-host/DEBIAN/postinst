#!/bin/sh
# smbd listens only on the addresses that exist when it starts (Samba's
# "bind interfaces only"). With ifupdown, nothing makes network-online.target,
# which smbd starts after, wait for a DHCP address, so after a reboot smbd
# served loopback only. ifupdown's wait service also waits for allow-hotplug
# interfaces (docs/adr/0031).
set -e

if [ "$1" = configure ] && [ -x /usr/sbin/ifquery ] &&
  [ -e /usr/lib/systemd/system/ifupdown-wait-online.service ] &&
  [ -n "$(ifquery --exclude=lo --list 2>/dev/null)$(ifquery --exclude=lo --allow=hotplug --list 2>/dev/null)" ]; then
  systemctl enable ifupdown-wait-online.service
fi
