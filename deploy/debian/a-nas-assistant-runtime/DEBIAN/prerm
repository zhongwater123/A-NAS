#!/bin/bash
# prerm of the AI assistant's Hermes runtime packages, a-nas-assistant-runtime-*
# (scripts/build-content-packages.sh). apt replaces the runtime before a-nas's
# postinst runs, so what runs on it stops first: the scheduled tasks' waker,
# which would start a round on a runtime being replaced, the montage center's
# planner, which runs on it, then the assistants, their API, scheduled tasks,
# curator and planning instances. a-nas's postinst starts the waker and the
# planner again; a member's next connection starts their assistant.
set -euo pipefail

[[ -d /run/systemd/system ]] || exit 0
case "${1:-}" in
  remove | upgrade | deconfigure)
    systemctl stop anas-assistant-cron-waker.service anas-montage-planner.service 2>/dev/null || true
    systemctl stop 'anas-assistant@*.service' 'anas-assistant-api@*.service' 'anas-assistant-cron@*.service' \
      'anas-assistant-curator@*.service' 'anas-assistant-planapi@*.service' 'anas-assistant-plan@*.service' 2>/dev/null || true
    ;;
esac
exit 0
