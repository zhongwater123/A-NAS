#!/bin/bash
# prerm of a-nas (ADR 0034). Removing the product stops its units; an upgrade
# or rollback leaves that to the next release's preinst, which stops the
# services that write the databases before it copies them. The montage
# service and the photo service's grant socket for it (ADR 0038) stop here on
# an upgrade too: a release before them knows nothing of their units, so a
# rollback to one would leave the service running, or the socket listening for
# a photo service that no longer reads it, after dpkg removed the units. The
# next release's postinst starts the service again, and its photo service the
# socket; the photo service keeps its copy of the socket until it restarts.
# The montage center's socket for planning stops before the montage service,
# each time: root's planner or a member's planning instance that connects to it
# starts the service again (its Service=), which would then run on after the
# rollback, or write videocut.db while the next release's preinst copies it.
# It starts again with the montage service (its Wants=). Removing the product
# also stops the planner and the members' planning instances. The shared
# workspace service (ADR 0040) stops on an upgrade for the montage service's
# reason: a rollback to a release before it would leave it running.
set -euo pipefail

if [[ -d /run/systemd/system ]]; then
  # Stop while the unit and its cleanup program are still installed, including
  # when downgrading to a release that does not have the hotspot.
  case "${1:-}" in
    remove | upgrade)
      if [[ "$(systemctl show -p LoadState --value anas-phone-hotspot.service)" == loaded ]]; then
        systemctl stop anas-phone-hotspot.service
      fi
      ;;
  esac
  case "${1:-}" in
    remove)
      systemctl stop anas-videocut-planner.service 'anas-assistant-planapi@*.service' 'anas-assistant-plan@*.service' || true
      systemctl stop anas-videocut-assistant.socket || true
      systemctl stop 'anas-kiosk@*.service' anas-search.service anas-search-dns.path anas-search-dns.service \
        anas-api.service anas-photos.service anas-shares.service anas-family.service anas-videocut.service anas-workspace.service \
        anas-host-agent.service \
        anas-ai.socket anas-ai.service anas-ffmpeg.socket anas-photos-grants.socket 'anas-vectors-proxy@*.socket' \
        'anas-vectors-proxy@*.service' 'anas-vectors@*.service' anas-container-agent.service anas-internet-firewall.service \
        anas-site.service anas-videocut-compute.socket anas-videocut-compute.service || true
      ;;
    upgrade)
      systemctl stop anas-videocut-assistant.socket || true
      systemctl stop anas-videocut.service anas-photos-grants.socket anas-videocut-compute.socket anas-videocut-compute.service \
        anas-workspace.service || true
      ;;
  esac
fi
exit 0
