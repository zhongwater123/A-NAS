# Names the disk that holds the /usr slots for the /usr transfer of
# systemd-sysupdate (see /usr/lib/sysupdate.d/50-usr.transfer).
[Unit]
Description=Link the system disk for systemd-sysupdate
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'mkdir -p /run/a-nas && ln -sfn "$(bootctl -RR)" /run/a-nas/system-disk'
