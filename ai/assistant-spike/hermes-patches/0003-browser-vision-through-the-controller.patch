From: A-NAS
Subject: [PATCH] feat(browser-control): browser_vision on a controller lane inspects its screenshot

On a lane bound to a browser controller every browser tool is routed to the
controller, browser_vision included, and fails closed: vision is not a
controller capability ("bound browser controller cannot execute
browser_vision"). The controller protocol does allow `browser_screenshot`
(gateway/browser_control_broker.py), but at the pinned 0e427d78 and on main
c5a3c0f8 (2026-10-20) no tool asks for it, so a model driving a controller's
browser can read its accessibility snapshot but never see the page.

On such a lane browser_vision now asks the controller for `browser_screenshot`
({"annotate": bool} -> {"mime_type": "image/png", "data": <base64>,
"annotations"?}), keeps the PNG in cache/screenshots like a local capture and
inspects it the same way: attached for a native-vision main model, else
described once by the auxiliary vision model. The tool is offered there when a
vision backend exists. Without a controller that takes screenshots nothing
changes. Drop this file once upstream routes browser_vision through
`browser_screenshot`.
---
diff --git a/tests/tools/test_browser_vision_controller.py b/tests/tools/test_browser_vision_controller.py
new file mode 100755
index 00000000..8bac63fd
--- /dev/null
+++ b/tests/tools/test_browser_vision_controller.py
@@ -0,0 +1,81 @@
+"""browser_vision on a bound controller lane (A-NAS patch 0003): vision is not a controller
+capability, so Hermes asks the controller for ``browser_screenshot`` and inspects that PNG."""
+
+import base64
+import json
+
+import pytest
+
+import tools.browser_tool as bt
+from tools.registry import registry
+
+# A 1x1 PNG.
+PNG = base64.b64decode("iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==")
+
+
+@pytest.fixture
+def lane(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setattr(bt, "extension_controller_available", lambda action: action == "browser_screenshot")
+    monkeypatch.setattr("tools.vision_tools._should_use_native_vision_fast_path", lambda: False)
+    routed = []
+
+    def answer(reply):
+        def route(action, args, **kw):
+            routed.append((action, args, kw.get("session_id")))
+            return reply
+        monkeypatch.setattr(bt, "routed_browser_handler", route)
+    return routed, answer
+
+
+def call(args):
+    return json.loads(registry.get_entry("browser_vision").handler(args, task_id="task", session_id="session"))
+
+
+def test_inspects_the_controllers_screenshot(lane, monkeypatch):
+    routed, answer = lane
+    answer(json.dumps({"mime_type": "image/png", "data": base64.b64encode(PNG).decode(), "width": 1, "height": 1}))
+    seen = []
+    monkeypatch.setattr(bt._vision, "_analyze_screenshot_with_aux_llm",
+                        lambda path, question: seen.append((path.read_bytes(), question)) or "a desktop with one window")
+    out = call({"question": "what is open?"})
+    assert routed == [("browser_screenshot", {"annotate": False}, "session")]
+    assert out["success"] is True and out["analysis"] == "a desktop with one window"
+    assert seen == [(PNG, "what is open?")]
+
+
+def test_passes_the_controllers_annotations_on(lane, monkeypatch):
+    routed, answer = lane
+    labels = [{"ref": "e1", "label": "相册"}]
+    answer(json.dumps({"mime_type": "image/png", "data": base64.b64encode(PNG).decode(), "annotations": labels}))
+    monkeypatch.setattr(bt._vision, "_analyze_screenshot_with_aux_llm", lambda path, question: "labels")
+    out = call({"question": "where is 相册?", "annotate": True})
+    assert routed[0][1] == {"annotate": True}
+    assert out["annotations"] == labels
+
+
+@pytest.mark.parametrize("reply", [
+    json.dumps({"mime_type": "image/jpeg", "data": base64.b64encode(PNG).decode()}),
+    json.dumps({"mime_type": "image/png", "data": base64.b64encode(b"not a png").decode()}),
+    json.dumps({"mime_type": "image/png", "data": "%%%"}),
+    "not json",
+    None,
+])
+def test_refuses_anything_but_a_png(lane, monkeypatch, reply):
+    _, answer = lane
+    answer(reply)
+    monkeypatch.setattr(bt._vision, "_analyze_screenshot_with_aux_llm", lambda *a: pytest.fail("analysed a non-PNG"))
+    out = call({"question": "?"})
+    assert out["success"] is False and "PNG" in out["error"]
+
+
+def test_offered_on_a_lane_that_takes_screenshots(monkeypatch):
+    monkeypatch.setattr(bt._install, "check_browser_vision_requirements", lambda: False)
+    monkeypatch.setattr("tools.vision_tools.check_vision_requirements", lambda: True)
+    monkeypatch.setattr(bt, "extension_controller_available", lambda action: action == "browser_screenshot")
+    assert bt.check_browser_vision_routed_requirements() is True
+    monkeypatch.setattr(bt, "extension_controller_available", lambda action: False)
+    assert bt.check_browser_vision_routed_requirements() is False
+    monkeypatch.setattr(bt, "extension_controller_available", lambda action: True)
+    monkeypatch.setattr("tools.vision_tools.check_vision_requirements", lambda: False)
+    assert bt.check_browser_vision_routed_requirements() is False
diff --git a/tools/browser_tool.py b/tools/browser_tool.py
