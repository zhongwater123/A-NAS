# The trial of the AI assistant on the Experimental NAS (nas-trial.sh): what the
# sandboxes bind under /run, made again at every boot.
d /run/a-nas-assistant 0755 root root -
d /run/anas-assistant-gw 0755 root root -
d /run/anas-assistant-photos 0755 root root -
f /run/anas-assistant-photos/photos.sock 0644 root root -
d /run/anas-change-agent 0755 root root -
f /run/anas-change-agent/agent.sock 0644 root root -
