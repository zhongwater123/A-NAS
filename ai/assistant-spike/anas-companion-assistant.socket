[Unit]
Description=A-NAS Product Service socket for members' assistants' companion tools (trial)
# The Product Service's socket for the companion tools of members' assistants (#412): it
# passes each call on to the VNAS window of the conversation that made it, and learns
# the member from the peer UID. Open to every UID, so its directory is root's alone; each
# assistant's unit binds the socket itself into its sandbox, and the scheduled tasks'
# units do not. systemd holds it, so it outlives restarts of the Product Service and the
# copies bound into running sandboxes keep working. product-settings.sh hands it to
# anas-api.service.

[Socket]
ListenStream=/run/a-nas-companion-assistant/assistant.sock
SocketMode=0666
DirectoryMode=0700
FileDescriptorName=companion
Service=anas-api.service

[Install]
WantedBy=sockets.target
