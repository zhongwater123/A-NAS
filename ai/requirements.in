# The AI Worker's runtime on Debian 13 (CPython 3.13, x86_64). The runtime's
# packages and hashes are in requirements.txt, which
#   scripts/build-ai-runtime.sh --lock
# resolves from this file with uv (`--upgrade-package NAME` passes through).
# Rerun the real-model tests after any change.
#
# MediaPipe itself. Importing it loads its drawing utilities, which import
# OpenCV and Matplotlib, so both stay although the Worker only embeds.
mediapipe==1.2.3
# The headless build in place of MediaPipe's opencv-contrib-python, which needs
# X libraries: requirements.excludes keeps that one out.
opencv-contrib-python-headless==5.0.0.93
# Object detection (docs/architecture/photo-objects.md).
onnxruntime==1.32.0
# Montage compute Worker. Keep these direct because it imports both.
numpy==2.5.5
pillow==13.0.0
# The aesthetic scorer (docs/architecture/photo-ai.md#美学打分) and the
# versions its bundle was tested with. PyPI's Linux build of PyTorch is the
# CUDA one, which brings gigabytes of NVIDIA libraries: PyTorch's own index
# has the CPU build, named by URL so that no other package comes from there.
torch @ https://download.pytorch.org/whl/cpu/torch-2.14.1%2Bcpu-cp313-cp313-manylinux_2_28_x86_64.whl
torchvision @ https://download.pytorch.org/whl/cpu/torchvision-0.29.1%2Bcpu-cp313-cp313-manylinux_2_28_x86_64.whl
transformers==5.23.0
safetensors==0.8.0
pydantic==2.14.3
