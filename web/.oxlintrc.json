{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Oxlint's correctness rules, and eslint-plugin-react-hooks with the React Compiler's checks. The plugin
  // runs as react-hooks-js: Oxlint keeps the name react-hooks for its own port, which is turned off.
  "plugins": ["typescript", "unicorn", "oxc", "react", "import", "vitest"],
  "jsPlugins": [{ "name": "react-hooks-js", "specifier": "eslint-plugin-react-hooks" }],
  "categories": { "correctness": "error" },
  "rules": {
    "react/rules-of-hooks": "off",
    "react/exhaustive-deps": "off",
    "react/refs": "off",
    "react/set-state-in-effect": "off",
    "react/purity": "off",
    "react/immutability": "off",
    "react/incompatible-library": "off",
    "react-hooks-js/rules-of-hooks": "error",
    "react-hooks-js/exhaustive-deps": "error",
    "react-hooks-js/static-components": "error",
    "react-hooks-js/use-memo": "error",
    "react-hooks-js/void-use-memo": "error",
    "react-hooks-js/preserve-manual-memoization": "error",
    "react-hooks-js/immutability": "error",
    "react-hooks-js/globals": "error",
    "react-hooks-js/refs": "error",
    "react-hooks-js/set-state-in-effect": "error",
    "react-hooks-js/error-boundaries": "error",
    "react-hooks-js/purity": "error",
    "react-hooks-js/set-state-in-render": "error",
    "react-hooks-js/unsupported-syntax": "error",
    "react-hooks-js/config": "error",
    "react-hooks-js/gating": "error",
    // It reports components React Compiler would leave alone; the app is not built with the compiler.
    "react-hooks-js/incompatible-library": "off",
    // Vitest's expect takes a message as its second argument.
    "vitest/valid-expect": ["error", { "maxArgs": 2 }],
    // Type parameters on vi.fn() are a typing style; tsc checks the tests.
    "vitest/require-mock-type-parameters": "off",
    // Request stubs check each request's headers as it arrives.
    "vitest/no-conditional-expect": "off"
  },
  "ignorePatterns": ["src/assistant/hermes/**"],
  // These files predate the hooks rules. They load data from effects and keep the latest values in refs,
  // which the rules reject; changing that rewrites each component's data flow and needs a review of its
  // own. Every other file must pass. Take a file off a list once it passes that rule.
  "overrides": [
    {
      "files": [
        "src/App.test.tsx",
        "src/appcenter/AppCenterPanel.tsx",
        "src/appcenter/InstallSheet.tsx",
        "src/assistant/useAssistantThread.ts",
        "src/docker/DockerPanel.tsx",
        "src/media/MediaCenter.tsx",
        "src/media/Player.tsx",
        "src/photos/AIHome.tsx",
        "src/photos/AlbumPicker.tsx",
        "src/photos/AssetGrid.tsx",
        "src/photos/Collections.tsx",
        "src/photos/People.tsx",
        "src/photos/PhotoScroller.tsx",
        "src/photos/PhotosPanel.tsx",
        "src/photos/Slideshow.tsx",
        "src/photos/Timeline.tsx",
        "src/photos/VideoPlayer.tsx",
        "src/photos/Viewer.tsx",
        "src/shares/Conversation.tsx",
        "src/shares/ShareDetail.tsx",
        "src/shares/SharePreview.tsx",
        "src/shares/SharesProvider.tsx",
        "src/shares/shares.test.tsx",
        "src/useHostState.ts"
      ],
      "rules": { "react-hooks-js/exhaustive-deps": "off" }
    },
    {
      "files": [
        "src/App.tsx",
        "src/DesktopGrid.tsx",
        "src/Dock.tsx",
        "src/SystemRail.tsx",
        "src/XtermSession.tsx",
        "src/assistant/AssistantPanel.tsx",
        "src/assistant/useAssistantThread.ts",
        "src/backup/RestoreDialog.tsx",
        "src/feedback/FeedbackChannel.tsx",
        "src/feedback/FeedbackEditor.tsx",
        "src/media/Player.tsx",
        "src/media/uploads.ts",
        "src/music/MusicPanel.tsx",
        "src/music/player.ts",
        "src/photos/AssetGrid.tsx",
        "src/photos/PhotosPanel.tsx",
        "src/photos/Slideshow.tsx",
        "src/photos/Timeline.tsx",
        "src/photos/grid.tsx",
        "src/photos/selection.ts",
        "src/photos/uploads.tsx",
        "src/settings/AvatarDialog.tsx",
        "src/settings/StorageSection.tsx",
        "src/settings/WallpaperDialog.tsx",
        "src/shares/ShareDetail.tsx",
        "src/shares/SharesProvider.tsx"
      ],
      "rules": { "react-hooks-js/refs": "off" }
    },
    {
      "files": [
        "src/App.tsx",
        "src/SettingsPanel.tsx",
        "src/appcenter/AppCenterPanel.tsx",
        "src/appcenter/InstallSheet.tsx",
        "src/appcenter/model.ts",
        "src/assistant/AssistantPanel.tsx",
        "src/backup/FindPage.tsx",
        "src/backup/RestoreDialog.tsx",
        "src/backup/SnapshotsPage.tsx",
        "src/backup/VersionsDialog.tsx",
        "src/docker/ContainerLogs.tsx",
        "src/docker/DockerPanel.tsx",
        "src/feedback/FeedbackChannel.tsx",
        "src/files/FileViewer.tsx",
        "src/media/Browse.tsx",
        "src/media/Cards.tsx",
        "src/media/Dropdown.tsx",
        "src/media/Folders.tsx",
        "src/media/Home.tsx",
        "src/media/Libraries.tsx",
        "src/media/Player.tsx",
        "src/media/PlayerPanel.tsx",
        "src/media/Upload.tsx",
        "src/music/NowPlaying.tsx",
        "src/music/SourcesDialog.tsx",
        "src/photos/People.tsx",
        "src/photos/PhotosPanel.tsx",
        "src/photos/Sidebar.tsx",
        "src/photos/Slideshow.tsx",
        "src/photos/Viewer.tsx",
        "src/settings/ImageSources.tsx",
        "src/settings/StorageSection.tsx",
        "src/settings/TerminalSection.tsx",
        "src/shares/Conversation.tsx",
        "src/shares/EmojiInput.tsx",
        "src/shares/SaveDialog.tsx",
        "src/shares/ShareComposer.tsx",
        "src/shares/ShareDetail.tsx",
        "src/shares/SharePreview.tsx",
        "src/shares/SharesPanel.tsx",
        "src/transfers/TransferNotices.tsx",
        "src/trash/TrashPanel.tsx",
        "src/useDesktopOrder.ts",
        "src/useHostState.ts"
      ],
      "rules": { "react-hooks-js/set-state-in-effect": "off" }
    },
    {
      "files": ["src/App.tsx", "src/media/Player.tsx", "src/settings/StorageSection.tsx"],
      "rules": { "react-hooks-js/purity": "off" }
    },
    {
      "files": ["src/media/Player.tsx", "src/photos/Timeline.tsx"],
      "rules": { "react-hooks-js/immutability": "off" }
    }
  ]
}
