+      const last = switched.current;
+      switched.current = { chain: ownAnim, anim, once, seq, cuePlayback };
+      if (
+        cuePlayback === null &&
+        last !== null &&
+        last.cuePlayback !== null &&
+        last.chain === ownAnim &&
+        last.anim === anim &&
+        last.once === once &&
