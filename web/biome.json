{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["**", "!src/assistant/hermes", "!src/*.generated.ts", "!package.json", "!package-lock.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": [".oxlintrc.json"],
      "json": { "parser": { "allowComments": true } }
    }
  ],
  "linter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  }
}
